# ─── Azure Auth ───────────────────────────────────────────────────────────────
# Antes do tofu apply, rode:
#   az login
#   az account set --subscription <subscription_id>
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

location            = "brazilsouth"
resource_group_name = "infra-rg"

# ─── ACR ──────────────────────────────────────────────────────────────────────
# Nome global único no Azure (só letras/números, sem hífens)
acr_name = "meuprojetoacr"

# ─── auth-service / MariaDB ───────────────────────────────────────────────────
# Host externo onde o banco roda (VM, managed DB, etc.)
auth_db_url = "jdbc:mariadb://SEU_HOST:3306/auth_db"
db_user     = "app_user"
db_password = "troque-esta-senha"

jwt_secret     = "troque-este-segredo-minimo-32-bytes"
jwt_expiration = 3600000

# ─── presenca-service / PostgreSQL ────────────────────────────────────────────
presenca_db_url      = "jdbc:postgresql://SEU_HOST:5432/presenca_db?sslmode=disable"
presenca_db_user     = "presenca_user"
presenca_db_password = "troque-esta-senha"

# ─── relatorio-service / PostgreSQL ───────────────────────────────────────────
relatorio_db_url = "Host=SEU_HOST;Port=5432;Database=relatorio_db;Username=relatorio_user;Password=troque;SSL Mode=Disable"

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
rabbitmq_host     = "SEU_HOST"
rabbitmq_port     = 5672
rabbitmq_username = "rabbitmq"
rabbitmq_password = "troque-esta-senha"
