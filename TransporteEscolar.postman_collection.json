{
  "info": {
    "name": "Transporte Escolar — API",
    "description": "Collection completa da API do sistema de transporte escolar. Base URL configurável via variável de ambiente.\n\nComo usar:\n1. Importe esta collection\n2. Crie um Environment com a variável `base_url` = https://api-gateway.politegrass-b0f9539d.brazilsouth.azurecontainerapps.io\n3. Execute **Auth / Login** — o token será salvo automaticamente\n4. Todas as demais requisições usam o token automaticamente",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://api-gateway.gentlemushroom-414bf899.brazilsouth.azurecontainerapps.io" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{base_url}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@furb.br\",\n  \"password\": \"senha123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "const res = pm.response.json();",
                "if (res.token) {",
                "  pm.collectionVariables.set('token', res.token);",
                "  console.log('Token salvo com sucesso');",
                "}"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{base_url}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"joao@furb.br\",\n  \"password\": \"senha123\"\n}"
            }
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/api/auth/users/{{user_id}}/role",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ROLE_ADMIN\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Administração (RegisterAdm)",
      "item": [
        {
          "name": "Alunos",
          "item": [
            {
              "name": "Listar alunos",
              "request": { "method": "GET", "url": "{{base_url}}/admin/alunos" }
            },
            {
              "name": "Cadastrar aluno",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/admin/alunos",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"matricula\": \"2023001\",\n  \"nome\": \"Maria Souza\",\n  \"email\": \"maria@furb.br\",\n  \"telefone\": \"47999999999\",\n  \"rotaTransporte\": \"Rota 1\",\n  \"cursoId\": 1,\n  \"nomeCurso\": \"Ciência da Computação\",\n  \"faculdade\": \"FURB\",\n  \"confirmouPresenca\": false\n}"
                }
              }
            },
            {
              "name": "Atualizar presença do aluno",
              "request": {
                "method": "PUT",
                "url": {
                  "raw": "{{base_url}}/alunos/{{aluno_id}}/presenca?presente=true",
                  "query": [{ "key": "presente", "value": "true" }]
                }
              }
            }
          ]
        },
        {
          "name": "Motoristas",
          "item": [
            {
              "name": "Listar motoristas",
              "request": { "method": "GET", "url": "{{base_url}}/admin/motoristas" }
            },
            {
              "name": "Cadastrar motorista",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/admin/motoristas",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nome\": \"Carlos Motorista\",\n  \"carteiraMotorista\": \"12345678901\"\n}"
                }
              }
            }
          ]
        },
        {
          "name": "Veículos",
          "item": [
            {
              "name": "Listar veículos",
              "request": { "method": "GET", "url": "{{base_url}}/admin/veiculos" }
            },
            {
              "name": "Cadastrar veículo",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/admin/veiculos",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"placa\": \"ABC-1234\",\n  \"modelo\": \"Ônibus Mercedes\",\n  \"capacidade\": 40\n}"
                }
              }
            },
            {
              "name": "Atualizar capacidade",
              "request": {
                "method": "PUT",
                "url": {
                  "raw": "{{base_url}}/veiculos/{{veiculo_id}}/capacidade?capacidade=45",
                  "query": [{ "key": "capacidade", "value": "45" }]
                }
              }
            },
            {
              "name": "Remover veículo",
              "request": { "method": "DELETE", "url": "{{base_url}}/veiculos/{{veiculo_id}}" }
            }
          ]
        },
        {
          "name": "Eleição (Bully Algorithm)",
          "item": [
            {
              "name": "Iniciar eleição",
              "request": { "method": "GET", "url": "{{base_url}}/eleicao/iniciar" }
            }
          ]
        }
      ]
    },
    {
