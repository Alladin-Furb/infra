                  "raw": "{\n  \"alunoId\": 1,\n  \"cursoId\": 1,\n  \"dataPresenca\": \"2026-05-31\",\n  \"status\": \"PRESENTE\",\n  \"horaEntrada\": \"18:50\",\n  \"horaSaida\": \"22:30\",\n  \"horasAulaComparecidas\": 4,\n  \"horasAulaTotal\": 4\n}"
                }
